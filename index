 ${hist.length?`<h2>Últimos intentos</h2><div class="card">${hist.slice(-5).reverse().map(h=>`<div class="row" style="justify-content:space-between"><span>${esc(h.c)}</span><b>${h.s}/${h.n}</b><span class="mu">${h.d}</span></div><div class="bar" style="margin:4px 0 10px"><i style="width:${Math.round(100*h.s/h.n)}%"></i></div>`).join('')}</div>`:''}
 <p class="mu foot">Preguntas de práctica escritas según la estructura de la prueba Saber TyT. No son preguntas oficiales del ICFES.</p>
 <p class="foot" style="text-align:center;font-weight:700;color:var(--gd)">Centro de Comercio y Servicios · Regional Caldas · SENA</p>`;
 app.querySelectorAll('.tile').forEach(b=>b.onclick=()=>start(b.dataset.c,false));
 bindSim();
 if($('#bf'))$('#bf').onclick=()=>start('fail',false);
 app.querySelectorAll('.seg button').forEach(b=>b.onclick=()=>{sv('sn',+b.dataset.n);app.querySelectorAll('.seg button').forEach(x=>x.classList.toggle('on',x===b))});
}

function importFile(e){
 const f=e.target.files[0];if(!f)return;
 if(typeof XLSX==='undefined'){say('No se pudo cargar el lector de Excel. Revisa tu conexión e inténtalo de nuevo.');return}
 const r=new FileReader();
 r.onload=()=>{try{
  const wb=XLSX.read(r.result,{type:'array'}),rows=XLSX.utils.sheet_to_json(wb.Sheets[wb.SheetNames[0]],{header:1,defval:''});
  const map=t=>{t=String(t).toLowerCase();return /lect|crit/.test(t)?'lc':/ing|eng/.test(t)?'in':/raz|cuant|mat/.test(t)?'rc':/ciud|comp/.test(t)?'cc':null};
  const out=[];
  rows.forEach(x=>{const c=map(x[0]),a='ABCD'.indexOf(String(x[6]).trim().toUpperCase().charAt(0)),o=[x[2],x[3],x[4],x[5]].map(v=>String(v).trim()).filter(Boolean);
   if(c&&x[1]&&a>=0&&a<o.length&&String(x[6]).trim().length===1)out.push({c,q:String(x[1]),o,a,e:String(x[7]||'')})});
  if(!out.length){say('No encontré preguntas válidas. Revisa el orden de las columnas y que la respuesta correcta sea A, B, C o D.');return}
  bank=out;sv('bank',out);home();say('Listo: se cargaron '+out.length+' preguntas.')
 }catch(err){say('No se pudo leer el archivo. Prueba guardándolo de nuevo como .xlsx o .csv.')}};
 r.readAsArrayBuffer(f);
}

function simSetup(){
 const max=bank.length,def=Math.min(ld('sq',20),max);
 app.innerHTML=`<button class="btn alt" id="bk" style="padding:8px 14px;margin-bottom:10px">← Inicio</button>
 <div class="card"><h2 style="margin-top:0">Simulacro mixto</h2><p class="mu">Elige cuántas preguntas quieres resolver. Se mezclan las cuatro categorías y tienes 1 min 30 s por pregunta.</p>
 <div class="seg" id="qs" style="flex-wrap:wrap">${[10,20,40,60,100].filter(v=>v<=max).map(v=>`<button data-v="${v}">${v}</button>`).join('')}</div>
 <p><label>Otra cantidad: <input type="number" id="qn" min="1" max="${max}" value="${def}" style="width:5.5em;padding:8px;border-radius:8px;border:1px solid var(--bd);background:var(--sf);color:var(--tx);font:inherit"></label> <span class="mu">(máximo ${max})</span></p>
 <p class="mu" id="qt"></p><button class="btn" id="go">Empezar simulacro</button></div>`;
 const val=()=>Math.max(1,Math.min(max,Math.floor(+$('#qn').value)||1));
 const upd=()=>{const v=val();$('#qt').textContent=v+' preguntas · tiempo total: '+String(v*1.5).replace('.',',')+' minutos'};
 upd();$('#qn').oninput=upd;
 app.querySelectorAll('#qs button').forEach(b=>b.onclick=()=>{$('#qn').value=b.dataset.v;upd()});
 $('#bk').onclick=home;
 $('#go').onclick=()=>{const v=val();sv('sq',v);start('mix',true,v)};
}

function start(c,sim,nn){
 const n=nn||ld('sn',10),fails=ld('fails',[]);
 const pool=c==='fail'?bank.filter(q=>fails.includes(q.q+'|'+q.o[q.a])):c==='mix'?bank:bank.filter(q=>q.c===c);
 if(!pool.length){say('Todavía no hay preguntas en esta categoría.');return}
 const mp=q=>{const ix=shuf(q.o.map((_,i)=>i));return{...q,o:ix.map(i=>q.o[i]),a:ix.indexOf(q.a)}},N=n||pool.length,U=[],gm={},T=[],seen=new Set(),L=[];
 pool.forEach(q=>{if(q.g){if(!gm[q.g]){gm[q.g]=[];U.push(gm[q.g])}gm[q.g].push(q)}else U.push([q])});
 const GU=U.filter(u=>u[0].g),SU=U.filter(u=>!u[0].g),sel=[],used=new Set(),all=!n;let cnt=0;
 const tr=u=>{if(all||u.length<=3)return u;return shuf(u.map((_,i)=>i)).slice(0,3).sort((a,b)=>a-b).map(i=>u[i])};
 const gq=pool.filter(q=>q.g).length,want=all?0:(c==='mix'?Math.round(N*gq/pool.length):Math.ceil(N*0.6));
 for(const u of shuf(GU)){if(cnt>=want)break;let v=tr(u);if(cnt+v.length>want)v=v.slice(0,want-cnt);sel.push(v);used.add(u);cnt+=v.length}
 for(const u of shuf(SU)){if(cnt>=N)break;sel.push(u);cnt+=u.length}
 for(const u of shuf(GU)){if(cnt>=N)break;if(used.has(u))continue;let v=tr(u);if(cnt+v.length>N)v=v.slice(0,N-cnt);sel.push(v);cnt+=v.length}
 const list=shuf(sel).flat().slice(0,N).map(mp);
 S={c,name:c==='mix'?'Mixto':c==='fail'?'Mis falladas':CATS[c],list,i:0,score:0,wrong:[],sel:null,sim,t:list.length*90};
 if(sim){clearInterval(tmr);tmr=setInterval(()=>{S.t--;const el=$('#tm');if(el)el.textContent=fmt(S.t);if(S.t<=0)finish()},1000)}
 quiz();
}
const fmt=s=>Math.floor(s/60)+':'+String(s%60).padStart(2,'0');

function quiz(){
 const q=S.list[S.i],n=S.list.length,done=S.sel!=null,ok=S.sel===q.a;
 app.innerHTML=`<div class="qw" style="--c:${COL[q.c]}">
 <div class="qtop"><button class="back" id="ex"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l9-8 9 8"/><path d="M5 10v10h5v-6h4v6h5V10"/></svg>Inicio</button>${S.sim?`<span class="pill">⏱ <span id="tm">${fmt(S.t)}</span></span>`:''}</div>
 <div class="meta"><span class="tag" style="background:var(--c)">${esc(CATS[q.c])}</span><span class="mu">Pregunta ${S.i+1} de ${n}</span></div>
 <div class="bar"><i style="width:${100*(S.i+(done?1:0))/n}%;background:var(--c)"></i></div>
 ${(q.t||q.im)?`<div class="ctx"><b>${esc(q.tt||"Texto")}</b>${esc(q.t||'')}${q.im?`<div class="fig">${q.im}</div>`:''}</div>`:''}
 <div class="qcard">${esc(q.q)}</div>
 ${q.o.map((t,k)=>`<button class="opt${done?(k===q.a?' ok':k===S.sel?' no':''):''}" data-k="${k}" ${done?'disabled':''}><span class="lt">${done&&k===q.a?'✓':done&&k===S.sel?'✗':'ABCD'[k]}</span><span>${t.startsWith('<svg')?t:esc(t)}</span></button>`).join('')}
 ${done?`<div class="fb${ok?'':' no'}"><b>${ok?'¡Correcto!':'Incorrecto.'}</b> ${esc(q.e||'')}</div><button class="btn nxt" id="nx">${S.i+1<n?'Siguiente pregunta ›':'Ver resultado ›'}</button>`:''}</div>`;
 app.querySelectorAll('.opt').forEach(b=>b.onclick=()=>pick(+b.dataset.k));
 if(done)$('#nx').onclick=()=>{if(S.i+1<n){S.i++;S.sel=null;quiz()}else finish()};
 $('#ex').onclick=home;
}

function pick(k){
 if(S.sel!=null)return;const q=S.list[S.i];S.sel=k;
 const d=ld('daily',{});d[day()]=(d[day()]||0)+1;sv('daily',d);
 let fails=ld('fails',[]);
 if(k===q.a){S.score++;fails=fails.filter(x=>x!==q.q+'|'+q.o[q.a])}else{S.wrong.push(q);if(!fails.includes(q.q+'|'+q.o[q.a]))fails.push(q.q+'|'+q.o[q.a])}
 sv('fails',fails);quiz();
}

function finish(){
 clearInterval(tmr);const n=S.list.length,pct=Math.round(100*S.score/n);
 const hist=ld('hist',[]);hist.push({c:S.name,s:S.score,n,d:day()});sv('hist',hist.slice(-30));
 const best=ld('best',{});if(S.c!=='fail'&&(best[S.c]==null||pct>best[S.c])){best[S.c]=pct;sv('best',best)}
 const txt=`Entrenando TYT · ${S.name}: ${S.score}/${n} (${pct} %) · ${day()}`;
 app.innerHTML=`<div class="card" style="text-align:center"><div class="big" style="font-size:2.6rem">${pct} %</div><p><b>${S.score} de ${n} correctas</b></p>
 <p class="mu">${pct>=80?'¡Excelente! Sigue así.':pct>=50?'Vas bien. Repasa las falladas y vuelve a intentarlo.':'Cada intento suma. Repasa las explicaciones y practica de nuevo.'}</p>
 <div class="row" style="justify-content:center"><button class="btn" id="cp">Copiar resultado</button><button class="btn alt" id="rp">Repetir</button><button class="btn alt" id="hm">Inicio</button></div></div>
 ${S.wrong.length?`<h2>Para repasar</h2><div class="card">${S.wrong.map(q=>`<div class="fail"><b>${esc(q.q)}</b><br><span style="color:var(--ok)">Respuesta: ${'ABCD'[q.a]}. ${esc(q.o[q.a])}</span><br><span class="mu">${esc(q.e||'')}</span></div>`).join('')}</div>`:''}`;
 $('#cp').onclick=()=>{const ok=()=>{$('#cp').textContent='¡Copiado!'};
  try{navigator.clipboard.writeText(txt).then(ok,fb)}catch(e){fb()}
  function fb(){const t=document.createElement('textarea');t.value=txt;document.body.appendChild(t);t.select();try{document.execCommand('copy');ok()}catch(e){say(txt)}t.remove()}};
 const c=S.c,sim=S.sim;
 $('#rp').onclick=()=>start(c,sim);
 $('#hm').onclick=home;
}
$('#logoSvg').style.cursor='pointer';$('#logoSvg').onclick=()=>home();$('#logo').onclick=()=>home();
home();
</script></body></html>
